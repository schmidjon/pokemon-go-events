{%- comment -%}
  Shared logic, prepended to every layout.
  The polled feed is a JSON array, which TRMNL exposes as `data`.
  Times without a trailing "Z" are local to the player; times with "Z" are UTC.
  Produces two sorted arrays of rows, `active` and `upcoming`.
  Each row is "sortkey~~name~~heading~~when~~tip~~images"; split it on "~~".
  `images` is ready-to-print HTML for the Pokémon the event features.
{%- endcomment -%}
{%- assign cf = trmnl.plugin_settings.custom_fields_values -%}
{%- assign now = "now" | date: "%s" | plus: 0 -%}
{%- assign offset = trmnl.user.utc_offset | default: 0 | plus: 0 -%}
{%- assign horizon_days = cf.horizon_days | default: 14 | plus: 0 -%}
{%- if horizon_days < 1 -%}{%- assign horizon_days = 14 -%}{%- endif -%}
{%- assign horizon = horizon_days | times: 86400 | plus: now -%}
{%- capture hidden -%},{{ cf.hide_types | join: "," | remove: " " }},{%- endcapture -%}
{%- comment -%} Species slugs in National Dex order, so forloop.index is the dex number. {%- endcomment -%}
