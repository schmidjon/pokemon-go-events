{%- assign art_base = "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/" -%}
{%- assign pokeball = "data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCI+PGcgZmlsbD0ibm9uZSIgc3Ryb2tlPSIjMDAwIiBzdHJva2Utd2lkdGg9IjIiPjxjaXJjbGUgY3g9IjEyIiBjeT0iMTIiIHI9IjEwIi8+PHBhdGggZD0iTTIgMTJoN202IDBoNyIvPjxjaXJjbGUgY3g9IjEyIiBjeT0iMTIiIHI9IjMiLz48L2c+PC9zdmc+" -%}
{%- assign active_rows = "" -%}
{%- assign upcoming_rows = "" -%}

{%- for e in data -%}
  {%- if e.start == nil or e.end == nil -%}{%- continue -%}{%- endif -%}
  {%- capture type_key -%},{{ e.eventType }},{%- endcapture -%}
  {%- if hidden contains type_key -%}{%- continue -%}{%- endif -%}

  {%- assign s = e.start | date: "%s" | plus: 0 -%}
  {%- assign t = e.end | date: "%s" | plus: 0 -%}
  {%- unless e.start contains "Z" -%}{%- assign s = s | minus: offset -%}{%- endunless -%}
  {%- unless e.end contains "Z" -%}{%- assign t = t | minus: offset -%}{%- endunless -%}
  {%- if t <= now or s > horizon -%}{%- continue -%}{%- endif -%}

  {%- if s <= now -%}
    {%- assign is_active = true -%}
    {%- assign key = t -%}
  {%- else -%}
    {%- assign is_active = false -%}
    {%- assign key = s -%}
  {%- endif -%}
  {%- assign delta = key | minus: now -%}

  {%- assign d_days = delta | divided_by: 86400 -%}
  {%- assign d_hours = delta | modulo: 86400 | divided_by: 3600 -%}
  {%- assign d_mins = delta | modulo: 3600 | divided_by: 60 -%}
  {%- capture span -%}
    {%- if d_days > 0 -%}{{ d_days }}d {{ d_hours }}h{%- elsif d_hours > 0 -%}{{ d_hours }}h {{ d_mins }}m{%- else -%}{{ d_mins }}m{%- endif -%}
  {%- endcapture -%}

  {%- assign local_key = key | plus: offset -%}
  {%- capture when -%}
    {%- if is_active -%}
      Ends in {{ span }}
    {%- elsif d_days < 6 -%}
      {{ local_key | date: "%a %-l:%M%P" }} · in {{ span }}
    {%- else -%}
      {{ local_key | date: "%a %b %-d, %-l:%M%P" }}
    {%- endif -%}
  {%- endcapture -%}

  {%- capture tip -%}
    {%- case e.eventType -%}
      {%- when "community-day" -%}
        {%- assign mon = e.extraData.communityday.spawns.first.name | default: "the featured Pokémon" -%}
        Clear storage, stock balls, Lucky Egg + Star Piece. Save {{ mon }} candy to evolve before it ends.
      {%- when "pokemon-spotlight-hour" -%}
        {%- assign bonus = e.extraData.spotlight.bonus | default: "" -%}
        {%- if bonus contains "Stardust" -%}
          Pop a Star Piece at the start; carry plenty of Poké Balls.
        {%- elsif bonus contains "Evolution" or bonus contains "Evolve" -%}
          Hoard candy for evolutions and use a Lucky Egg.
        {%- elsif bonus contains "XP" -%}
          Use a Lucky Egg and Nanab berries for quick catches.
        {%- elsif bonus contains "Transfer" -%}
          Save up Pokémon to transfer during the hour.
        {%- elsif bonus contains "Candy" -%}
          Stock Pinap Berries to stack the candy bonus.
        {%- else -%}
          Restock Poké Balls and clear storage beforehand.
        {%- endif -%}
      {%- when "raid-hour" -%}
        Gather a group or invite friends; heal and pre-build a counter team.
      {%- when "raid-battles" -%}
        {%- if e.name contains "Shadow" -%}
          Hold Purified Gems and Max Revives; Shadow raids need a solid group.
        {%- elsif e.name contains "Mega" -%}
          Bring a matching Mega for bonus candy; Mega Energy adds up.
        {%- else -%}
          Spin a gym daily for your free pass; set up a counter team.
        {%- endif -%}
      {%- when "raid-day" -%}
        Spin gyms for extra free passes. Stock Max Revives and potions.
      {%- when "max-battles" -%}
        Fill up on Max Particles at Power Spots; power up Dynamax counters.
      {%- when "max-mondays" -%}
        Collect Max Particles over the weekend; find a Power Spot group.
      {%- when "go-battle-league" -%}
        Build and test teams for the new cups before rating sets in.
      {%- when "go-pass" -%}
        Finish the daily GO Pass tasks and claim rewards before it ends.
      {%- when "pokemon-go-tour" or "wild-area" or "city-safari" or "safari-zone" or "pokemon-go-fest" -%}
        {%- if e.name contains "Global" -%}
          Grab the ticket early, clear storage, stock Incense and balls.
        {%- else -%}
          Ticketed, in person: plan your route, pack a battery and water.
        {%- endif -%}
      {%- when "elite-raids" -%}
        In person only: arrive early with a group and a ready team.
      {%- when "go-rocket-takeover" or "team-go-rocket" -%}
        Heal up, grab a Rocket Radar, and spin stops for Grunts.
      {%- when "pokestop-showcase" -%}
        Hunt big (XXL) examples of the featured species.
      {%- when "twitch-drops" -%}
        Link your Twitch and Pokémon GO accounts before the stream.
      {%- when "season" -%}
        Check the new spawns, egg pools, and seasonal bonuses.
      {%- when "research" or "special-research" or "timed-research" or "limited-research" -%}
        Claim the research now and finish it before the deadline.
      {%- else -%}
        {%- if e.extraData.generic.hasFieldResearchTasks -%}
          Spin PokéStops for event Field Research; clear item storage.
        {%- elsif e.extraData.generic.hasSpawns -%}
          Clear Pokémon storage and save Incense for the event spawns.
        {%- else -%}
          Clear storage and check bonuses on LeekDuck.
        {%- endif -%}
    {%- endcase -%}
  {%- endcapture -%}

  {%- comment -%}
    Featured Pokémon: use the feed's own icons when it lists them (raid bosses,
    Spotlight, Community Day); otherwise find species named in the headline.
  {%- endcomment -%}
  {%- assign xd = e.extraData -%}
  {%- assign feed_mons = xd.raidbattles.bosses | default: xd.spotlight.list | default: xd.communityday.spawns -%}
  {%- capture srcs -%}
    {%- for m in feed_mons limit: 3 -%}{{ m.image }},{%- endfor -%}
  {%- endcapture -%}
  {%- if srcs == "" -%}
    {%- capture hay -%}-{{ e.name | downcase | replace: "é", "e" | remove: "." | remove: "'" | remove: "’" | replace: " ", "-" | replace: "(", "-" | replace: ")", "-" | replace: ",", "-" | replace: ":", "-" | replace: "&", "-" | replace: "|", "-" | replace: "/", "-" }}-{%- endcapture -%}
    {%- assign found = 0 -%}
    {%- capture srcs -%}
      {%- for slug in poke_names -%}
        {%- capture needle -%}-{{ slug }}-{%- endcapture -%}
        {%- if hay contains needle -%}
          {{ art_base }}{{ forloop.index }}.png,
          {%- assign found = found | plus: 1 -%}
          {%- if found >= 3 -%}{%- break -%}{%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}
  {%- endif -%}
  {%- assign src_list = srcs | split: "," -%}
  {%- capture imgs -%}
    {%- if src_list.size == 0 -%}
      <img class="image image--adaptive w--8 h--8" src="{{ pokeball }}" alt="">
    {%- elsif src_list.size == 1 -%}
      <img class="image image-dither image--contain w--12 h--12" src="{{ src_list.first }}" alt="">
    {%- else -%}
      {%- for src in src_list -%}<img class="image image-dither image--contain w--6 h--6" src="{{ src }}" alt="">{%- endfor -%}
    {%- endif -%}
  {%- endcapture -%}

  {%- assign name = e.name | remove: "~~" | remove: "^^" -%}
  {%- capture row -%}{{ key }}~~{{ name }}~~{{ e.heading }}~~{{ when | strip }}~~{{ tip | strip }}~~{{ imgs }}{%- endcapture -%}
  {%- if is_active -%}
    {%- assign active_rows = active_rows | append: row | append: "^^" -%}
  {%- else -%}
    {%- assign upcoming_rows = upcoming_rows | append: row | append: "^^" -%}
  {%- endif -%}
{%- endfor -%}

{%- assign active = active_rows | split: "^^" | sort -%}
{%- assign upcoming = upcoming_rows | split: "^^" | sort -%}

{%- comment -%}
  One event row. Pass `row`; set `compact: true` for one-line tips in short slots.
{%- endcomment -%}
{% template event_item %}
{%- assign f = row | split: "~~" -%}
<div class="item flex pb--2 w--full">
  <div class="icon">
    <div class="flex flex--row flex--center-x flex--center-y w--20 h--12">{{ f[5] }}</div>
  </div>
  <div class="content">
    <span class="title title--small lg:title--base" data-clamp="1">{{ f[1] }}</span>
    <span class="description" data-clamp="1">{{ f[3] }}{% unless compact %} · {{ f[2] }}{% endunless %}</span>
    <span class="description" data-clamp="{% if compact %}1{% else %}2{% endif %}"><b>Prep:</b> {{ f[4] }}</span>
  </div>
</div>
{% endtemplate %}

{%- comment -%}
  Title bar. Pass `title`, `icon` (the Poké Ball data URI) and `trmnl`.
{%- endcomment -%}
{% template title_bar %}
<div class="title_bar">
  <img class="image image--adaptive" src="{{ icon }}" alt="">
  <span class="title">{{ title }}</span>
  <span class="instance">{{ trmnl.plugin_settings.instance_name }}</span>
</div>
{% endtemplate %}
