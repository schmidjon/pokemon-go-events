<div class="layout layout--col">
  <div class="flex flex--row portrait:flex--col flex--stretch gap--large w--full stretch">
    <div class="flex flex--col flex--left gap--small stretch">
      <span class="label label--underline">Happening now</span>
      <div class="stretch w--full">
        <div class="flex flex--col flex--left gap--none w--full" data-overflow="true" data-overflow-max-height="auto" data-overflow-counter="true">
          {%- for r in active limit: 12 %}
            {% render "event_item", row: r %}
          {%- else %}
            <span class="description">Nothing live right now.</span>
          {%- endfor %}
        </div>
      </div>
    </div>
    <div class="flex flex--col flex--left gap--small stretch">
      <span class="label label--underline">Coming up</span>
      <div class="stretch w--full">
        <div class="flex flex--col flex--left gap--none w--full" data-overflow="true" data-overflow-max-height="auto" data-overflow-counter="true">
          {%- for r in upcoming limit: 12 %}
            {% render "event_item", row: r %}
          {%- else %}
            <span class="description">No events in the next {{ horizon_days }} days.</span>
          {%- endfor %}
        </div>
      </div>
    </div>
  </div>
</div>
{% render "title_bar", title: "Pokémon GO Events", icon: pokeball, trmnl: trmnl %}
